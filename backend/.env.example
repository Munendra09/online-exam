# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ltaexam_db
DB_USER=root
DB_PASS=yourpassword

# JWT
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# Bcrypt rounds (10 recommended)
BCRYPT_ROUNDS=10

# OTP Mode: "client" (OTP shown on screen) or "server" (sent via email)
OTP_MODE=client

# SMTP (only needed if OTP_MODE=server)
# SMTP_HOST=smtp.gmail.com
# OTP_EXPIRY_MINUTES=10
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=yourapppassword
# SMTP_FROM_NAME=Lucky Tech Academy
# SMTP_FROM_EMAIL=your@gmail.com
